# Biomate configuration.
#
# The secrets Gradle plugin reads `.env` (git-ignored) and falls back to this file, then
# injects the values as BuildConfig fields and manifest placeholders. Copy this file to
# `.env` and fill in real values; never commit `.env`.
#
# See README.md for how to obtain each key.

# Google Maps SDK key. Required for the OnTrail map to render tiles.
# Without it the map area shows a permission error instead of a map; the rest of the app,
# including GPS tracking and distance, still works.
# Restrict the key to this app's package name and signing certificate in Google Cloud.
MAPS_API_KEY=YOUR_MAPS_API_KEY

# Optional. Only used by the legacy direct-REST Gemini path.
# The supported route is Firebase AI Logic, which proxies requests server-side and needs
# no key in the app — see README.md. Leave this as-is unless you know you need it.
GEMINI_API_KEY=MY_GEMINI_API_KEY
