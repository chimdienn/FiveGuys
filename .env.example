# Biomate local configuration. Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. Never commit or share real API keys.

# Google Maps SDK for Android key used by the live OnTrail map.
MAPS_API_KEY=YOUR_MAPS_API_KEY

# Google AI Studio Gemini API key used by Camera > Identify and Camera > Challenge.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
